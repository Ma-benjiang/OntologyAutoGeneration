{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/fixer-output-v1.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "round", "target", "replacement"],
      "properties": {
        "version": { "const": 1 },
        "round": { "type": "integer", "minimum": 1, "maximum": 19 },
        "target": { "enum": ["CQ", "SRD"] },
        "replacement": { "type": "string", "minLength": 1 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "round", "target", "replacement"],
      "properties": {
        "version": { "const": 1 },
        "round": { "type": "integer", "minimum": 1, "maximum": 19 },
        "target": { "const": "SCHEMA_CARD" },
        "replacement": { "type": "object" }
      }
    }
  ]
}
