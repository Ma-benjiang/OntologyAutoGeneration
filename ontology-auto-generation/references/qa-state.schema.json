{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/qa-state-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "round", "seen_findings"],
  "properties": {
    "version": { "const": 1 },
    "round": { "type": "integer", "minimum": 1, "maximum": 20 },
    "seen_findings": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "uniqueItems": true
    }
  }
}
