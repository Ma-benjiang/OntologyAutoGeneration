{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/abox-candidates-v1.json",
  "title": "ABox Extraction Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entities", "assertions"],
  "properties": {
    "version": { "const": 1 },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "assertions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assertion" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "heading_path", "line_start", "line_end", "quote"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "heading_path": { "type": "array", "items": { "type": "string" } },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1 }
      }
    },
    "businessIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_iri", "value"],
      "properties": {
        "property_iri": { "type": "string", "format": "uri" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "class_iri", "name", "evidence"],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
        "class_iri": { "type": "string", "format": "uri" },
        "name": { "type": "string", "minLength": 1 },
        "business_identifier": {
          "oneOf": [
            { "$ref": "#/$defs/businessIdentifier" },
            { "type": "null" }
          ]
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_id", "kind", "subject_candidate_id", "property_iri", "object_candidate_id", "evidence"],
          "properties": {
            "candidate_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
            "kind": { "const": "object" },
            "subject_candidate_id": { "type": "string" },
            "property_iri": { "type": "string", "format": "uri" },
            "object_candidate_id": { "type": "string" },
            "evidence": { "$ref": "#/$defs/evidence" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_id", "kind", "subject_candidate_id", "property_iri", "value", "datatype", "evidence"],
          "properties": {
            "candidate_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
            "kind": { "const": "data" },
            "subject_candidate_id": { "type": "string" },
            "property_iri": { "type": "string", "format": "uri" },
            "value": { "type": "string" },
            "datatype": { "type": "string", "format": "uri", "pattern": "^http://www\\.w3\\.org/2001/XMLSchema#" },
            "evidence": { "$ref": "#/$defs/evidence" }
          }
        }
      ]
    }
  }
}
